rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App de demostración pública: cualquiera puede leer y escribir,
    // pero el servidor valida la forma de cada documento.
    match /libros/{id} {
      function generoValido(g) {
        return g in ['Novela', 'Ciencia', 'Tecnología', 'Historia', 'Poesía', 'Otro'];
      }
      function libroValido(d) {
        return d.keys().hasOnly(['titulo', 'autor', 'genero', 'anio', 'leido', 'creadoEn'])
          && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 120
          && d.autor is string && d.autor.size() > 0 && d.autor.size() <= 80
          && generoValido(d.genero)
          && d.anio is int && d.anio >= 1000 && d.anio <= 2100
          && d.leido is bool;
      }

      allow read: if true;
      allow create: if libroValido(request.resource.data)
        && request.resource.data.creadoEn == request.time;
      // Solo se permite cambiar el estado "leido".
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido'])
        && request.resource.data.leido is bool;
      allow delete: if true;
    }
  }
}

{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "max-age=300" }] }
    ]
  },
  "emulators": {
    "firestore": { "port": 8085 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}
